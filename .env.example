# Model backend: openai | ollama
LLM_PROVIDER=openai

# OpenAI (or any OpenAI-compatible API via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Ollama (free, local): https://ollama.com  ->  ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Agent / database
DB_PATH=data/shop.db
MAX_STEPS=8
MAX_ROWS=50
QUERY_TIMEOUT_S=5
